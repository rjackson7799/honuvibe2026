{
  "framework": "nextjs",
  "regions": ["hnd1"],
  "crons": [
    { "path": "/api/cron/presenter-summaries", "schedule": "0 * * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 * * * *" }
  ],
  "headers": [
    {
      "source": "/api/rss",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=600" }
      ]
    }
  ]
}
